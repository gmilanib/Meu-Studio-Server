{
  "info": {
    "_postman_id": "7247acb7-64fc-470d-aab1-a4e28d774e1f",
    "name": "Meu Studio API",
    "description": "Collection para validar a API Meu Studio. Execute as requisições na ordem indicada: criar usuário, login, obter CSRF e clientes. A API usa sessão (cookie JSESSIONID) e proteção CSRF (cookie XSRF-TOKEN).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9000", "type": "string" },
    { "key": "username", "value": "postmanuser", "type": "string" },
    { "key": "password", "value": "Postman@123", "type": "string" },
    { "key": "userEmail", "value": "postman.user@exemplo.com", "type": "string" },
    { "key": "userTelefone", "value": "11999990001", "type": "string" },
    { "key": "csrfToken", "value": "", "type": "string" },
    { "key": "clienteId", "value": "", "type": "string" },
    { "key": "clienteNome", "value": "Cliente Postman", "type": "string" },
    { "key": "clienteEmail", "value": "cliente.postman@exemplo.com", "type": "string" },
    { "key": "clienteTelefone", "value": "11988880001", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Autenticação",
      "item": [
        {
          "name": "01 - Criar usuário (primeira execução)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201 - usuário criado', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Resposta contém o username informado', function () { pm.expect(body.username).to.eql(pm.variables.get('username')); });"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{userEmail}}\",\n  \"telefone\": \"{{userTelefone}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/users",
            "description": "Cria o usuário usado no login. Execute somente uma vez por conjunto de valores, pois username, e-mail e telefone são únicos no banco."
          }
        },
        {
          "name": "02 - Login",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200 - login realizado', function () { pm.response.to.have.status(200); });",
              "pm.test('Sessão foi recebida', function () { pm.expect(pm.cookies.has('JSESSIONID')).to.be.true; });"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login",
            "description": "Autentica o usuário e faz o Postman guardar o cookie JSESSIONID automaticamente."
          }
        },
        {
          "name": "03 - Obter token CSRF",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 204 - token CSRF solicitado', function () { pm.response.to.have.status(204); });",
              "const token = pm.cookies.get('XSRF-TOKEN');",
              "pm.test('Cookie XSRF-TOKEN recebido', function () { pm.expect(token).to.exist; });",
              "if (token) { pm.collectionVariables.set('csrfToken', token); }"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/csrf",
            "description": "O Spring envia o cookie XSRF-TOKEN. O script o copia para a variável csrfToken, usada nos métodos POST, PUT e DELETE protegidos."
          }
        },
        {
          "name": "04 - Usuário autenticado",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200 - usuário atual retornado', function () { pm.response.to.have.status(200); });" ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me", "description": "Confirma que a sessão criada no login está ativa." }
        },
        {
          "name": "05 - Logout",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 204 - logout realizado', function () { pm.response.to.have.status(204); });" ] } }],
          "request": { "method": "POST", "header": [{ "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/auth/logout", "description": "Invalida a sessão. Execute apenas ao terminar a validação, pois as próximas requisições protegidas retornarão 401." }
        }
      ]
    },
    {
      "name": "02 - Clientes",
      "item": [
        {
          "name": "01 - Criar cliente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 - cliente criado', function () { pm.response.to.have.status(201); });",
            "const body = pm.response.json();",
            "pm.test('Resposta contém o id do cliente', function () { pm.expect(body.id).to.exist; });",
            "pm.collectionVariables.set('clienteId', body.id);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{clienteNome}}\",\n  \"email\": \"{{clienteEmail}}\",\n  \"telefone\": \"{{clienteTelefone}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/clientes", "description": "Cria um cliente e salva o id retornado na variável clienteId." }
        },
        {
          "name": "02 - Listar clientes",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200 - lista retornada', function () { pm.response.to.have.status(200); });", "pm.test('Resposta é uma lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });" ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/clientes", "description": "Retorna todos os clientes cadastrados." }
        },
        {
          "name": "03 - Buscar cliente por id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200 - cliente encontrado', function () { pm.response.to.have.status(200); });", "pm.test('Id corresponde à variável', function () { pm.expect(String(pm.response.json().id)).to.eql(String(pm.variables.get('clienteId'))); });" ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/clientes/{{clienteId}}", "description": "Usa o id capturado ao criar o cliente." }
        },
        {
          "name": "04 - Atualizar cliente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200 - cliente atualizado', function () { pm.response.to.have.status(200); });", "pm.test('Nome atualizado', function () { pm.expect(pm.response.json().nome).to.eql(pm.variables.get('clienteNome') + ' Atualizado'); });" ] } }],
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{clienteNome}} Atualizado\",\n  \"email\": \"{{clienteEmail}}\",\n  \"telefone\": \"11988880002\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/clientes/{{clienteId}}", "description": "Atualiza o cliente criado anteriormente." }
        },
        {
          "name": "05 - Excluir cliente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 204 - cliente excluído', function () { pm.response.to.have.status(204); });", "pm.collectionVariables.unset('clienteId');" ] } }],
          "request": { "method": "DELETE", "header": [{ "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/clientes/{{clienteId}}", "description": "Remove o cliente de teste. Este é o único endpoint da collection que altera dados de forma destrutiva." }
        }
      ]
    }
  ]
}
